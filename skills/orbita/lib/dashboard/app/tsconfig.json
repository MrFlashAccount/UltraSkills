{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "react", "react-dom"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../server/**/*.mjs", "../api.mjs"],
  "exclude": ["../../../node_modules"]
}
