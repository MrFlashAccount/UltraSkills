{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/runner-host-response",
  "title": "Workflow Runner Host Response",
  "type": "object",
  "required": ["status", "orchestratorInstruction", "baton"],
  "properties": {
    "status": { "enum": ["needs_host_actions", "done"] },
    "orchestratorInstruction": { "type": "string", "minLength": 1 },
    "baton": { "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton" },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stepId", "action"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stepId": { "type": "string", "minLength": 1 },
          "ownerStepId": { "type": "string", "minLength": 1 },
          "action": { "enum": ["run_worker", "wait_for_approval", "resolve_worker_blocker"] },
          "loadInstructionsCommand": { "type": "string", "minLength": 1 },
          "shard": { "$ref": "#/$defs/shardWorkRequest" },
          "matrix": { "$ref": "#/$defs/matrixWorkRequest" },
          "preferredAgentId": {
            "description": "Advisory opaque worker id previously bound for this step, or null when no binding exists.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "loadFollowupInstructionsCommand": {
            "description": "Instruction-loader command variant for a host-restored preferred worker. Uses the same validating write-output protocol as loadInstructionsCommand.",
            "type": "string",
            "minLength": 1
          },
          "recoverableBlocker": {
            "description": "Bounded public blocker details for a recoverable worker or approval pause. A resolve_worker_blocker request asks the host/orchestrator to resolve this blocker first; after accepted resolution, the same step receives resolved recovery context.",
            "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/recoverableWorkerBlocker"
          },
          "writeResolutionCommand": {
            "description": "Validating public runner command for writing the structured blocker resolution.",
            "type": "string",
            "minLength": 1
          },
          "outputSchema": { "type": "string", "minLength": 1 },
          "resolvedOutputSchema": {
            "type": "object",
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "schema": { "type": "object" }
            },
            "required": ["ref", "schema"],
            "additionalProperties": false
          },
          "approvalDelivery": { "$ref": "#/$defs/approvalDelivery" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "action": { "const": "run_worker" } },
              "required": ["action"]
            },
            "then": {
              "required": [
                "loadInstructionsCommand",
                "preferredAgentId",
                "loadFollowupInstructionsCommand"
              ],
              "not": {
                "required": ["approvalDelivery"]
              }
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "wait_for_approval" } },
              "required": ["action"]
            },
            "then": {
              "required": ["approvalDelivery"],
              "not": {
                "anyOf": [
                  { "required": ["preferredAgentId"] },
                  { "required": ["loadFollowupInstructionsCommand"] },
                  { "required": ["recoverableBlocker"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "resolve_worker_blocker" } },
              "required": ["action"]
            },
            "then": {
              "required": [
                "recoverableBlocker",
                "writeResolutionCommand"
              ],
              "not": {
                "anyOf": [
                  { "required": ["preferredAgentId"] },
                  { "required": ["loadFollowupInstructionsCommand"] },
                  { "required": ["loadInstructionsCommand"] },
                  { "required": ["approvalDelivery"] }
                ]
              }
            }
          }
        ]
      }
    },
    "runId": { "type": "string", "minLength": 1 },
    "initialized": { "type": "boolean" },
    "resumed": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "approvalDelivery": {
      "type": "object",
      "required": [
        "message",
        "summary",
        "attachments",
        "options",
        "recommendedAction",
        "expectedNormalizedOutput"
      ],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "contentType": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "stepId": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "field", "value", "normalizedOutput"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 },
              "value": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              },
              "normalizedOutput": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "recommendedAction": { "type": "string", "minLength": 1 },
        "expectedNormalizedOutput": {
          "type": "object",
          "required": ["format"],
          "properties": {
            "format": { "const": "strict_json" },
            "schemaRef": { "type": "string", "minLength": 1 },
            "schema": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "not": {
        "anyOf": [
          { "required": ["leaseToken"] },
          { "required": ["token"] },
          { "required": ["tokenHash"] },
          { "required": ["transcript"] },
          { "required": ["privatePrompt"] }
        ]
      }
    },
    "matrixWorkRequest": {
      "type": "object",
      "required": ["owner_step_id", "unit_id", "request_id", "required", "attempts", "max_attempts", "context"],
      "properties": {
        "owner_step_id": { "type": "string", "minLength": 1 },
        "unit_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "context": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "shardWorkRequest": {
      "type": "object",
      "required": [
        "obligation_id",
        "shard_id",
        "reviewer_role",
        "required",
        "privacy_route",
        "max_attempts",
        "source_evidence"
      ],
      "properties": {
        "obligation_id": { "type": "string", "minLength": 1 },
        "shard_id": { "type": "string", "minLength": 1 },
        "reviewer_role": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "privacy_route": { "const": "safe_context" },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "source_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false,
      "not": {
        "anyOf": [
          { "required": ["leaseToken"] },
          { "required": ["token"] },
          { "required": ["prompt"] },
          { "required": ["transcript"] },
          { "required": ["session"] },
          { "required": ["lifecycle"] },
          { "required": ["storagePath"] },
          { "required": ["outputPath"] },
          { "required": ["controlPlane"] }
        ]
      }
    }
  }
}
