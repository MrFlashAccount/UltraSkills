{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/runner-host-response",
  "title": "Workflow Runner Host Response",
  "type": "object",
  "required": [
    "status",
    "orchestratorInstruction",
    "baton"
  ],
  "properties": {
    "status": {
      "enum": [
        "needs_host_actions",
        "done"
      ]
    },
    "orchestratorInstruction": {
      "type": "string",
      "minLength": 1
    },
    "baton": {
      "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stepId",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "ownerStepId": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "run_worker",
              "wait_for_approval",
              "resolve_non_blocking_stop"
            ]
          },
          "loadInstructionsCommand": {
            "type": "string",
            "minLength": 1
          },
          "agentRuntime": {
            "description": "Advisory fresh-worker model and thinking level selected from the executable source worker's per-harness agent_runtime configuration.",
            "type": "object",
            "required": [
              "model",
              "thinkingLevel"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
              },
              "thinkingLevel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
              }
            },
            "additionalProperties": false
          },
          "shard": {
            "$ref": "#/$defs/shardWorkRequest"
          },
          "fanout": {
            "$ref": "#/$defs/fanoutWorkRequest"
          },
          "preferredAgentId": {
            "description": "Advisory opaque worker id previously bound for this step, or null when no binding exists.",
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "loadFollowupInstructionsCommand": {
            "description": "Instruction-loader command variant for a host-restored preferred worker. Uses the same validating write-output protocol as loadInstructionsCommand.",
            "type": "string",
            "minLength": 1
          },
          "nonBlockingStop": {
            "description": "Bounded public details for a request-level non-blocking stop. A resolve_non_blocking_stop request asks the host or user for the missing help; after resolution, the same request resumes with that context.",
            "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/nonBlockingStop"
          },
          "resolveStopCommand": {
            "description": "Validating public runner command for writing the structured stop resolution.",
            "type": "string",
            "minLength": 1
          },
          "outputSchema": {
            "type": "string",
            "minLength": 1
          },
          "resolvedOutputSchema": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "object"
              }
            },
            "required": [
              "ref",
              "schema"
            ],
            "additionalProperties": false
          },
          "parentStepId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "run_worker"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "loadInstructionsCommand",
                "preferredAgentId",
                "loadFollowupInstructionsCommand"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "wait_for_approval"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "preferredAgentId"
                    ]
                  },
                  {
                    "required": [
                      "loadFollowupInstructionsCommand"
                    ]
                  },
                  {
                    "required": [
                      "nonBlockingStop"
                    ]
                  },
                  {
                    "required": [
                      "agentRuntime"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "resolve_non_blocking_stop"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "nonBlockingStop",
                "resolveStopCommand"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "preferredAgentId"
                    ]
                  },
                  {
                    "required": [
                      "loadFollowupInstructionsCommand"
                    ]
                  },
                  {
                    "required": [
                      "loadInstructionsCommand"
                    ]
                  },
                  {
                    "required": [
                      "agentRuntime"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "initialized": {
      "type": "boolean"
    },
    "resumed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fanoutWorkRequest": {
      "type": "object",
      "required": [
        "owner_step_id",
        "activation",
        "phase",
        "selected_branch_ids"
      ],
      "properties": {
        "owner_step_id": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "branches",
            "owner"
          ]
        },
        "selected_branch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "shardWorkRequest": {
      "type": "object",
      "required": [
        "parent_step_id",
        "activation",
        "phase"
      ],
      "properties": {
        "parent_step_id": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "shards",
            "worker"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "transcript"
            ]
          },
          {
            "required": [
              "leaseToken"
            ]
          },
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "storagePath"
            ]
          },
          {
            "required": [
              "outputPath"
            ]
          },
          {
            "required": [
              "controlPlane"
            ]
          }
        ]
      }
    }
  }
}
