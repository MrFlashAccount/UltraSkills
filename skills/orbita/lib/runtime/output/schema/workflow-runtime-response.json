{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/workflow-runtime-response",
  "title": "Workflow Runtime Response",
  "type": "object",
  "required": [
    "baton",
    "steps"
  ],
  "properties": {
    "baton": {
      "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/executableStep"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "executableStep": {
      "type": "object",
      "required": [
        "id",
        "action",
        "step"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ownerStepId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "run_worker",
            "wait_for_approval",
            "stop_done"
          ]
        },
        "step": {
          "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/workflow#/$defs/step"
        },
        "shard": {
          "$ref": "#/$defs/shardWork"
        },
        "fanout": {
          "$ref": "#/$defs/fanoutWork"
        },
        "parentStepId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fanoutWork": {
      "type": "object",
      "required": [
        "owner_step_id",
        "activation",
        "phase",
        "selected_branch_ids"
      ],
      "properties": {
        "owner_step_id": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "branches",
            "owner"
          ]
        },
        "selected_branch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "shardWork": {
      "type": "object",
      "required": [
        "parent_step_id",
        "activation",
        "phase"
      ],
      "properties": {
        "parent_step_id": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "shards",
            "worker"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
