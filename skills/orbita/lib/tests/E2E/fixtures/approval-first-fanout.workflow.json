{
  "name": "fixture-approval-first-fanout",
  "version": 1,
  "start": "intake_approval",
  "done": "done",
  "steps": {
    "intake_approval": {
      "name": "Intake Approval",
      "kind": "approval",
      "input": {
        "prompt": "Accept the startup request before worker execution."
      },
      "next": "prepare"
    },
    "prepare": {
      "name": "Prepare",
      "kind": "worker",
      "input": {
        "prompt": "Prepare approved startup request."
      },
      "output": {
        "template": "output.md",
        "schema": "schemas/routing-ready.schema.json"
      },
      "next": "implementation"
    },
    "implementation": {
      "name": "Implementation owner",
      "kind": "fanout",
      "input": {
        "branches": ["branch_a", "branch_b"],
        "prompt": [
          "Synthesize current branch results.",
          "Branch A result: ${{ input.branch_a.results | default: \"branch A not selected\" }}",
          "Branch B result: ${{ input.branch_b.results | default: \"branch B not selected\" }}"
        ]
      },
      "output": {
        "template": "output.md",
        "schema": "schemas/routing-ready.schema.json"
      },
      "branches": {
        "branch_a": {
          "input": { "prompt": "Do branch A.\nPrepare result:\n${{ input.prepare.results }}" },
          "output": { "template": "output.md", "schema": "schemas/routing-ready.schema.json" }
        },
        "branch_b": {
          "input": { "prompt": "Do branch B.\nPrepare result:\n${{ input.prepare.results }}" },
          "output": { "template": "output.md", "schema": "schemas/routing-ready.schema.json" }
        }
      },
      "next": "final_approval"
    },
    "final_approval": {
      "name": "Final Approval",
      "kind": "approval",
      "input": {
        "prompt": [
          "Approve final result.",
          "",
          "Implementation result:",
          "${{ input.implementation.results }}"
        ]
      },
      "next": {
        "match": "${{ output.approval }}",
        "cases": {
          "approved": "done"
        }
      }
    },
    "done": {
      "name": "Done",
      "kind": "done",
      "input": {
        "prompt": "Finished."
      }
    }
  }
}
