{
  "name": "fixture-loop-policies-self-loop",
  "version": 1,
  "start": "self_check",
  "done": "done",
  "limit_reached": "limit_reached",
  "loopPolicies": {
    "self_check": {
      "steps": [
        "self_check"
      ],
      "entry": "self_check",
      "boundary": "self_check",
      "maxIterations": 2,
      "onLimit": "limit_reached"
    }
  },
  "steps": {
    "self_check": {
      "name": "Self Check",
      "kind": "worker",
      "input": {
        "prompt": "Retry until ready or loop limit."
      },
      "output": {
        "template": "output.md",
        "schema": "schemas/loop-review.schema.json"
      },
      "next": {
        "match": "${{ output.outcome }}",
        "cases": {
          "ready": "done",
          "retry": "self_check",
          "limit_reached": "limit_reached"
        }
      }
    },
    "done": {
      "name": "Done",
      "kind": "done",
      "input": {
        "prompt": "Finished."
      }
    },
    "limit_reached": {
      "name": "Limit reached",
      "kind": "done",
      "input": {
        "prompt": "Loop limit reached."
      }
    }
  }
}
