{
  "name": "fixture-loop-policies-approval-revision",
  "version": 1,
  "start": "plan",
  "done": "done",
  "limit_reached": "limit_reached",
  "loopPolicies": {
    "approval_revision": {
      "steps": [
        "plan",
        "approval_gate"
      ],
      "entry": "plan",
      "boundary": "approval_gate",
      "maxIterations": 2,
      "onLimit": "limit_reached"
    },
    "implementation_revision": {
      "steps": [
        "implement",
        "review"
      ],
      "entry": "implement",
      "boundary": "review",
      "maxIterations": 2,
      "onLimit": "limit_reached"
    }
  },
  "steps": {
    "plan": {
      "name": "Plan",
      "kind": "worker",
      "input": {
        "prompt": "Plan the work."
      },
      "output": {
        "template": "output.md",
        "schema": "schemas/routing-ready.schema.json"
      },
      "next": "approval_gate"
    },
    "approval_gate": {
      "name": "Approval Gate",
      "kind": "approval",
      "input": {
        "summary": "${{ input.plan.outcome }}"
      },
      "next": {
        "match": "${{ output.approval }}",
        "cases": {
          "approved": "implement",
          "rejected": "plan"
        }
      }
    },
    "implement": {
      "name": "Implement",
      "kind": "worker",
      "input": {
        "prompt": [
          "Implement the approved plan.",
          "",
          "Review feedback to address:",
          "${{ input.review.results | default: \"No review feedback yet.\" }}"
        ]
      },
      "output": {
        "template": "output.md",
        "schema": "schemas/routing-ready.schema.json"
      },
      "next": "review"
    },
    "review": {
      "name": "Review",
      "kind": "worker",
      "input": {
        "prompt": [
          "Review implementation.",
          "",
          "Implementation result:",
          "${{ input.implement.results }}"
        ]
      },
      "output": {
        "template": "output.md",
        "schema": "schemas/loop-review.schema.json"
      },
      "next": {
        "match": "${{ output.outcome }}",
        "cases": {
          "ready": "done",
          "retry": "implement",
          "limit_reached": "limit_reached"
        }
      }
    },
    "done": {
      "name": "Done",
      "kind": "done",
      "input": {
        "prompt": "Finished."
      }
    },
    "limit_reached": {
      "name": "Limit reached",
      "kind": "done",
      "input": {
        "prompt": "Loop limit reached."
      }
    }
  }
}
