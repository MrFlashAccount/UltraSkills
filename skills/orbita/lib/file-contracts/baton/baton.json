{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton",
  "title": "Workflow Baton",
  "type": "object",
  "required": [
    "cursor",
    "status",
    "state"
  ],
  "properties": {
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "done"
      ]
    },
    "state": {
      "type": "object",
      "required": [
        "artifacts",
        "results"
      ],
      "properties": {
        "artifacts": {
          "description": "Aggregate artifact metadata entries keyed outside the artifact contract by producer step id. Items must be { producerStepId, artifact }, where artifact follows the central artifact metadata contract.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/aggregateArtifact"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          }
        },
        "attempts": {
          "description": "Interpreter-owned retry counters keyed by workflow edge.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "$loopProgress": {
          "description": "Interpreter-owned loop policy progress counters keyed by workflow loop policy id. Stores counters only, never policy definitions.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "$occurrenceProvenance": {
          "$ref": "#/$defs/occurrenceProvenance"
        },
        "shards": {
          "description": "Runner-owned shard activations keyed by their parent workflow step id. Resolved values are snapshotted once and accepted outputs are retained only as bounded references.",
          "type": "object",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_-]*$": {
              "$ref": "#/$defs/shardActivation"
            }
          },
          "additionalProperties": false
        },
        "fanouts": {
          "description": "Runner-owned fanout activation progress keyed by owner workflow step id. The owner cursor remains stable while branches and the owner worker execute.",
          "type": "object",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_-]*$": {
              "$ref": "#/$defs/fanoutActivation"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_-]*$": {
          "description": "Per-step worker output keyed by workflow step id for downstream prompt and transition input context."
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "run",
            "history"
          ]
        }
      },
      "additionalProperties": false
    },
    "workerBindings": {
      "description": "Runner-owned advisory worker reuse hints keyed by workflow step id or by the step's explicit logical agent name. Values are opaque host worker ids; this is not an attempt, lifecycle, session, transcript, or output registry.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonBlockingStops": {
      "description": "Runner-owned control-plane state for request-level non-blocking stops. Keys are active request ids; each stop_id is a worker-generated UUID v4 used for idempotent report retries and stale replay rejection. Unresolved values await orchestrator help, and resolved values are rendered back into the same request. These records never complete a step or advance the cursor.",
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/nonBlockingStop"
        }
      },
      "additionalProperties": false
    },
    "user_prompt": {
      "description": "Raw run-level startup user prompt captured when the workflow run is initialized. Immutable after start/resume.",
      "type": "string",
      "allOf": [
        {
          "pattern": "\\S"
        }
      ]
    },
    "error": {
      "type": "object"
    },
    "user_prompt_injected": {
      "description": "Interpreter/runner marker set after the selected startup-prompt worker output has been applied. Prevents reinjection after completion/resume or workflow drift while allowing repeated renders of the same uncompleted worker to preserve the prompt.",
      "type": "boolean"
    },
    "user_prompt_target": {
      "description": "Interpreter-owned selected startup worker step id that receives baton.user_prompt before any worker output exists. Stable across resume and workflow order drift.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "content_type",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact id unique within the producer step.",
          "x-usage": "Use with the producer step id to identify the artifact. Emit a stable id unique within the producer step; do not add producer_step_id, type, kind, ref, version, replaces, or aliases."
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "description": "MIME/content type, for example text/markdown or application/json.",
          "x-usage": "Use to render or parse the artifact content. Do not duplicate artifact meaning with type or kind fields."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Full absolute filesystem path to the generated artifact file.",
          "x-usage": "When producing an artifact file, write it inside the step's artifact output directory and emit the full absolute filesystem path here. Treat this path as the baton/output artifact pointer for later review, approval, or export. Do not rewrite it or use temp dirs, ad-hoc export paths, or paths outside the step artifact output directory."
        },
        "summary": {
          "type": "string",
          "description": "Optional compact handoff summary for the artifact.",
          "x-usage": "Use as orientation metadata only; the artifact content remains the source of truth for review or approval."
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "aggregateArtifact": {
      "type": "object",
      "required": [
        "producerStepId",
        "artifact"
      ],
      "properties": {
        "producerStepId": {
          "type": "string",
          "minLength": 1,
          "description": "Producer step id used only for aggregate identity; not part of the artifact metadata contract."
        },
        "producerOccurrence": {
          "type": "integer",
          "minimum": 1
        },
        "producerRequestId": {
          "type": "string",
          "minLength": 1
        },
        "acceptedFileStamp": {
          "$ref": "#/$defs/artifactFileStamp"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "artifactFileStamp": {
      "type": "object",
      "required": ["device", "inode", "size", "mtimeMs", "ctimeMs"],
      "properties": {
        "device": { "type": "number", "minimum": 0 },
        "inode": { "type": "number", "minimum": 0 },
        "size": { "type": "number", "minimum": 0 },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "ctimeMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "occurrenceProvenance": {
      "description": "Runner-owned forward-only occurrence counters and transient accepted artifact provenance. Legacy runs are seeded once without rewriting history.",
      "type": "object",
      "required": ["version", "counters", "current", "coverage", "pendingArtifactAcceptances"],
      "properties": {
        "version": { "const": 2 },
        "counters": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "current": {
          "type": "object",
          "required": ["ownerStepId", "occurrence"],
          "properties": {
            "ownerStepId": { "type": "string", "minLength": 1 },
            "occurrence": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "required": ["mode", "historyBytes"],
          "properties": {
            "mode": { "enum": ["complete", "forward_only"] },
            "historyBytes": { "type": "integer", "minimum": 0 },
            "currentAvailable": { "type": "boolean" },
            "firstAvailableByStep": {
              "description": "First trustworthy forward-written occurrence per owner step. Older seeded ordinals remain unavailable permanently.",
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 1 }
            }
          },
          "additionalProperties": false
        },
        "pendingArtifactAcceptances": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["ownerStepId", "ownerOccurrence", "producerRequestId", "artifacts"],
            "properties": {
              "ownerStepId": { "type": "string", "minLength": 1 },
              "ownerOccurrence": { "type": "integer", "minimum": 1 },
              "producerRequestId": { "type": "string", "minLength": 1 },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "acceptedFileStamp"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "acceptedFileStamp": { "$ref": "#/$defs/artifactFileStamp" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "nonBlockingStop": {
      "type": "object",
      "required": [
        "stop_id",
        "summary",
        "source_step_id",
        "needed"
      ],
      "properties": {
        "stop_id": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "needed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resolution": {
          "$ref": "#/$defs/recoveryResolution"
        }
      },
      "additionalProperties": false
    },
    "recoveryResolution": {
      "type": "object",
      "required": [
        "summary",
        "decision"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "shardActivation": {
      "type": "object",
      "required": [
        "parent_step_id",
        "activation",
        "phase",
        "status",
        "values",
        "max_parallel",
        "current_requests",
        "shard_records",
        "accepted_outputs"
      ],
      "properties": {
        "parent_step_id": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "shards",
            "worker",
            "completed"
          ]
        },
        "status": {
          "enum": [
            "awaiting_shards",
            "awaiting_worker",
            "completed"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": true
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "current_requests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shard_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shardRecord"
          }
        },
        "accepted_outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/shardAcceptedOutputRecord"
          }
        }
      },
      "additionalProperties": false
    },
    "fanoutActivation": {
      "type": "object",
      "required": [
        "owner_step_id",
        "activation",
        "phase",
        "status",
        "selected_branch_ids",
        "max_parallel",
        "current_requests",
        "branch_records",
        "accepted_outputs"
      ],
      "properties": {
        "owner_step_id": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "branches",
            "owner",
            "completed"
          ]
        },
        "status": {
          "enum": [
            "awaiting_branches",
            "awaiting_owner",
            "completed"
          ]
        },
        "selected_branch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "current_requests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branch_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fanoutBranchRecord"
          }
        },
        "accepted_outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fanoutAcceptedOutputRecord"
          }
        }
      },
      "additionalProperties": false
    },
    "fanoutBranchRecord": {
      "type": "object",
      "required": [
        "branch_id",
        "request_id",
        "status"
      ],
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "accepted"
          ]
        }
      },
      "additionalProperties": false
    },
    "fanoutAcceptedOutputRecord": {
      "type": "object",
      "required": [
        "branch_id",
        "request_id",
        "status",
        "output_ref"
      ],
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "accepted"
        },
        "output_ref": {
          "type": "object",
          "required": [
            "step_id"
          ],
          "properties": {
            "step_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shardRecord": {
      "type": "object",
      "required": [
        "index",
        "request_id",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "accepted"
          ]
        }
      },
      "additionalProperties": false
    },
    "shardAcceptedOutputRecord": {
      "type": "object",
      "required": [
        "index",
        "request_id",
        "status",
        "output_ref"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "accepted"
        },
        "output_ref": {
          "type": "object",
          "required": [
            "step_id"
          ],
          "properties": {
            "step_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
