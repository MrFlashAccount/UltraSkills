{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/workflow",
  "title": "Workflow Document",
  "description": "Workflow documents use the flat workflow root: name, version, start, done, and steps are defined at the JSON root.",
  "$ref": "#/$defs/workflow",
  "$defs": {
    "step": {
      "description": "Canonical target workflow step shape.",
      "oneOf": [
        {
          "$ref": "#/$defs/workerStep"
        },
        {
          "$ref": "#/$defs/approvalStep"
        },
        {
          "$ref": "#/$defs/matrixStep"
        },
        {
          "$ref": "#/$defs/fanoutStep"
        },
        {
          "$ref": "#/$defs/doneStep"
        }
      ]
    },
    "workerStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "output",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "worker"
        },
        "agent": {
          "description": "Optional stable logical agent name. Worker steps with the same agent share the same advisory host worker binding instead of using the workflow step id as the binding key.",
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/workerInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "sharding": {
          "$ref": "#/$defs/shardingPolicy"
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "matrixStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "input",
        "worker",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "matrix"
        },
        "input": {
          "$ref": "#/$defs/matrixInput"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "worker": {
          "$ref": "#/$defs/matrixWorkerTemplate"
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false
    },
    "matrixInput": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "$ref": "#/$defs/matrixItems"
        },
        "id_field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "context_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "matrixItems": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/staticMatrixUnit"
          }
        },
        {
          "$ref": "#/$defs/inputArrayExpression"
        }
      ]
    },
    "staticMatrixUnit": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "inputArrayExpression": {
      "description": "A path-only input expression that resolves to a non-empty array when the control step activation starts.",
      "type": "string",
      "pattern": "^\\$\\{\\{\\s*input\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*\\s*\\}\\}$"
    },
    "fanoutStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "input",
        "output",
        "branches",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "fanout"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/fanoutInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "branches": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fanoutBranchTemplate"
          }
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "fanoutInput": {
      "type": "object",
      "required": [
        "branches"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "$ref": "#/$defs/fanoutBranchSelection"
        }
      },
      "additionalProperties": false
    },
    "fanoutBranchSelection": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          }
        },
        {
          "$ref": "#/$defs/inputArrayExpression"
        },
        {
          "type": "object",
          "required": ["first_of"],
          "properties": {
            "first_of": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/inputArrayExpression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fanoutBranchTemplate": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/workerInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "matrixWorkerTemplate": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/workerInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "agentRuntimeByHarness": {
      "description": "Optional fresh-worker runtime preferences keyed by case-insensitive ASCII host harness identity. TOML may author entries as agent_runtime.<harness> = { model = ..., thinking_level = ... }; keys differing only by case are semantically invalid.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agentRuntimeProfile"
      }
    },
    "agentRuntimeProfile": {
      "type": "object",
      "required": ["model", "thinking_level"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
        },
        "thinking_level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "approvalStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "approval"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "output": {
          "$ref": "#/$defs/approvalOutput"
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false
    },
    "doneStep": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "done"
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        }
      },
      "additionalProperties": false
    },
    "workerInput": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "description": "Workflow prompt text. Use a string for compact prompts or an array of strings for readable multi-line authoring; array items are joined with newline characters before rendering.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "next": {
      "description": "One next step target, a path-only dynamic next expression, or match/cases routing from a path-only expression to scalar static targets.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/matchCasesNext"
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "shardingPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "mode",
        "obligations"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "mode": {
          "const": "review_shards"
        },
        "privacy_route": {
          "const": "safe_context"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shardObligation"
          }
        }
      },
      "additionalProperties": false
    },
    "shardObligation": {
      "type": "object",
      "required": [
        "shard_id",
        "reviewer_role"
      ],
      "properties": {
        "shard_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "privacy_route": {
          "const": "safe_context"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "source_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "approvalOutput": {
      "type": "object",
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nextCaseTarget": {
      "description": "One scalar workflow step target.",
      "type": "string",
      "minLength": 1
    },
    "matchCasesNext": {
      "type": "object",
      "required": [
        "match",
        "cases"
      ],
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/nextCaseTarget"
          }
        }
      },
      "additionalProperties": false
    },
    "loopPolicy": {
      "type": "object",
      "required": [
        "steps",
        "maxIterations",
        "onLimit"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "onLimit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "version",
        "start",
        "done",
        "steps"
      ],
      "not": {
        "required": [
          "workflow"
        ]
      },
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/step"
          }
        },
        "loopPolicies": {
          "description": "Optional loop policies keyed by policy id. Each policy must cover exactly one semantic validation-proven SCC or self-loop region. Runtime counts selected internal route events and routes to onLimit when maxIterations would be exceeded.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/loopPolicy"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
