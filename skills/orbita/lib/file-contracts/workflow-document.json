{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/workflow",
  "title": "Workflow Document",
  "description": "Workflow documents use the flat workflow root: name, version, start, done, and steps are defined at the JSON root.",
  "$ref": "#/$defs/workflow",
  "$defs": {
    "step": {
      "description": "Canonical target workflow step shape.",
      "oneOf": [
        {
          "$ref": "#/$defs/workerStep"
        },
        {
          "$ref": "#/$defs/approvalStep"
        },
        {
          "$ref": "#/$defs/shardStep"
        },
        {
          "$ref": "#/$defs/fanoutStep"
        },
        {
          "$ref": "#/$defs/doneStep"
        }
      ]
    },
    "workerStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "output",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "worker"
        },
        "agent": {
          "description": "Optional stable logical agent name. Worker steps with the same agent share the same advisory host worker binding instead of using the workflow step id as the binding key.",
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/workerInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "shardStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "input",
        "output",
        "worker",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "shard"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/shardInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "worker": {
          "$ref": "#/$defs/shardWorkerTemplate"
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "shardInput": {
      "type": "object",
      "required": [
        "shards"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "shards": {
          "$ref": "#/$defs/shardValues"
        }
      },
      "additionalProperties": false
    },
    "shardValues": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": true
        },
        {
          "$ref": "#/$defs/inputArrayExpression"
        }
      ]
    },
    "inputArrayExpression": {
      "description": "A path-only input expression that resolves to a non-empty array when the control step activation starts.",
      "type": "string",
      "pattern": "^\\$\\{\\{\\s*input\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*\\s*\\}\\}$"
    },
    "fanoutStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "input",
        "output",
        "branches",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "fanout"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/fanoutInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "branches": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fanoutBranchTemplate"
          }
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "fanoutInput": {
      "type": "object",
      "required": [
        "branches"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "$ref": "#/$defs/fanoutBranchSelection"
        }
      },
      "additionalProperties": false
    },
    "fanoutBranchSelection": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          }
        },
        {
          "$ref": "#/$defs/inputArrayExpression"
        },
        {
          "type": "object",
          "required": ["first_of"],
          "properties": {
            "first_of": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/inputArrayExpression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fanoutBranchTemplate": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/workerInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "shardWorkerTemplate": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_runtime": {
          "$ref": "#/$defs/agentRuntimeByHarness"
        },
        "input": {
          "$ref": "#/$defs/workerInput"
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "agent_runtime": ["agent"]
      }
    },
    "agentRuntimeByHarness": {
      "description": "Optional fresh-worker runtime preferences keyed by case-insensitive ASCII host harness identity. TOML may author entries as agent_runtime.<harness> = { model = ..., thinking_level = ... }; keys differing only by case are semantically invalid.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agentRuntimeProfile"
      }
    },
    "agentRuntimeProfile": {
      "type": "object",
      "required": ["model", "thinking_level"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
        },
        "thinking_level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "approvalStep": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "input",
        "next"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "approval"
        },
        "input": {
          "$ref": "#/$defs/approvalInput"
        },
        "next": {
          "$ref": "#/$defs/next"
        },
        "onReject": {
          "description": "Optional static revision target used when the runner-owned approval decision is rejected. When present, next describes only the approved route.",
          "$ref": "#/$defs/nextCaseTarget"
        }
      },
      "additionalProperties": false
    },
    "approvalInput": {
      "description": "Runner-owned typed approval projection. Every selector is a whole-string path expression rooted at input; approval prompt/template and output schema authoring are intentionally unsupported.",
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/approvalSelector"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvalSelector"
          }
        },
        "verdict": {
          "$ref": "#/$defs/approvalVerdict"
        }
      },
      "additionalProperties": false
    },
    "approvalSelector": {
      "description": "A whole-string input path selector such as ${{ input.research_draft.summary }}.",
      "type": "string",
      "minLength": 1
    },
    "approvalVerdict": {
      "type": "object",
      "required": [
        "outcome",
        "summary",
        "findings",
        "include_when"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/approvalSelector"
        },
        "summary": {
          "$ref": "#/$defs/approvalSelector"
        },
        "findings": {
          "$ref": "#/$defs/approvalSelector"
        },
        "include_when": {
          "type": "object",
          "required": [
            "selector",
            "equals"
          ],
          "properties": {
            "selector": {
              "$ref": "#/$defs/approvalSelector"
            },
            "equals": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "doneStep": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "done"
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        }
      },
      "additionalProperties": false
    },
    "workerInput": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "description": "Workflow prompt text. Use a string for compact prompts or an array of strings for readable multi-line authoring; array items are joined with newline characters before rendering.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "next": {
      "description": "One next step target, a path-only dynamic next expression, or match/cases routing from a path-only expression to scalar static targets.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/matchCasesNext"
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nextCaseTarget": {
      "description": "One scalar workflow step target.",
      "type": "string",
      "minLength": 1
    },
    "matchCasesNext": {
      "type": "object",
      "required": [
        "match",
        "cases"
      ],
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/nextCaseTarget"
          }
        }
      },
      "additionalProperties": false
    },
    "loopPolicy": {
      "type": "object",
      "required": [
        "steps",
        "entry",
        "boundary",
        "maxIterations",
        "onLimit"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "onLimit": {
          "description": "An independent transition descriptor evaluated only when a boundary repeat reaches the limit. It supports the same literal, dynamic-expression, and match/cases forms and output/input context as step.next. Every validation-proven target must already be a declared external target of the boundary step.",
          "$ref": "#/$defs/next"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "version",
        "start",
        "done",
        "steps"
      ],
      "not": {
        "required": [
          "workflow"
        ]
      },
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/step"
          }
        },
        "loopPolicies": {
          "description": "Optional loop policies keyed by policy id. Each policy must cover exactly one semantic validation-proven SCC or self-loop region with a single declared entry and boundary. Runtime counts completed entry-to-boundary traversals and uses the boundary's declared onLimit exit when another repeat would exceed maxIterations.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/loopPolicy"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
