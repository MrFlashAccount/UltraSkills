{
  "name": "skills-dev-harness-prototype",
  "private": true,
  "workspaces": [
    "shared/scripts/schema-validation"
  ],
  "type": "module",
  "scripts": {
    "test": "AGENT=1 make -C skills/orbita test && bun test --timeout=30000 scripts/render-html-selector-captures.test.mjs",
    "test:workflow-e2e": "AGENT=1 make -C skills/orbita test-workflow-e2e",
    "skill:doctor": "bun workflows/create-skill/scripts/doctor.mjs",
    "workflow:validate": "bun skills/orbita/lib/entrypoints/cli/validate-workflow.mjs workflows",
    "validate": "bun run dashboard:format:check && bun run dashboard:lint && bun run dashboard:typecheck && bun run dashboard:test && bun run dashboard:test:runtime && bun run depcruise:check && bun run role-evidence:check && bun run test && bun run workflow:validate && bun run agents:check && bun run schema-validation:check-vendor-ajv",
    "prepare": "git config core.hooksPath .githooks || true",
    "schema-validation:bundle-vendor-ajv": "bun scripts/bundle-schema-validation-vendor-ajv.mjs",
    "schema-validation:check-vendor-ajv": "bun run schema-validation:bundle-vendor-ajv && git diff --exit-code -- shared/scripts/schema-validation/vendor/ajv.mjs && test -z \"$(git status --porcelain -- shared/scripts/schema-validation/vendor/ajv.mjs)\"",
    "maintain:bundle-schema-validation-vendor-ajv": "bun run schema-validation:bundle-vendor-ajv",
    "agents:generate": "bun scripts/generate-codex-agents.mjs",
    "depcruise:check": "bun --bun depcruise --config .dependency-cruiser.cjs skills/orbita/lib",
    "agents:check": "bun scripts/check-generated-codex-agents.mjs",
    "role-evidence:check": "python3 scripts/check_role_evidence.py",
    "dashboard:dev": "bun --bun vite --config skills/orbita/lib/dashboard/ui/vite.config.ts",
    "dashboard:format": "bun --bun oxfmt --config ./node_modules/@sergeigarin/hygene/oxfmt.json --write skills/orbita/lib/dashboard '!skills/orbita/lib/dashboard/ui/.output/**' '!skills/orbita/lib/dashboard/ui/e2e/proof/**' '!skills/orbita/lib/dashboard/ui/e2e/results/**' '!skills/orbita/lib/dashboard/ui/src/routeTree.gen.ts'",
    "dashboard:format:check": "bun --bun oxfmt --config ./node_modules/@sergeigarin/hygene/oxfmt.json --check skills/orbita/lib/dashboard '!skills/orbita/lib/dashboard/ui/.output/**' '!skills/orbita/lib/dashboard/ui/e2e/proof/**' '!skills/orbita/lib/dashboard/ui/e2e/results/**' '!skills/orbita/lib/dashboard/ui/src/routeTree.gen.ts'",
    "dashboard:lint": "bun --bun oxlint --config skills/orbita/lib/dashboard/oxlint.config.mjs --tsconfig skills/orbita/lib/dashboard/ui/tsconfig.json --deny-warnings skills/orbita/lib/dashboard",
    "dashboard:build": "bun --bun vite build --config skills/orbita/lib/dashboard/ui/vite.config.ts",
    "dashboard:start": "HOST=${ORBITA_DASHBOARD_HOST:-127.0.0.1} PORT=${ORBITA_DASHBOARD_PORT:-3000} bun skills/orbita/lib/dashboard/ui/.output/server/index.mjs",
    "dashboard:typecheck": "bun --bun tsc --noEmit -p skills/orbita/lib/dashboard/ui/tsconfig.json",
    "dashboard:test": "bun test --timeout=30000 --preload ./skills/orbita/lib/dashboard/ui/src/test/happy-dom.ts --preload ./skills/orbita/lib/dashboard/ui/src/test/setup.ts skills/orbita/lib/dashboard/ui/src/features",
    "dashboard:test:runtime": "bun test --timeout=30000 --parallel skills/orbita/lib/dashboard/contracts skills/orbita/lib/dashboard/observer skills/orbita/lib/dashboard/projection skills/orbita/lib/dashboard/ui/src/server skills/orbita/lib/dashboard/dashboard-v2-inventory.test.ts",
    "dashboard:test:browser": "bun --bun playwright test --config skills/orbita/lib/dashboard/ui/playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.27",
    "@tanstack/react-virtual": "3.14.5",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.10.6",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@sergeigarin/hygene": "github:MrFlashAccount/hygiene#b5efc1eb4229d84c81a39b76e7f8d4b7c841cfe1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "^8.17.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.0.0",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  },
  "packageManager": "bun@1.3.14"
}
