{
  "name": "skills-dev-harness-prototype",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "AGENT=1 make -C skills/orbita test",
    "test:workflow-e2e": "AGENT=1 make -C skills/orbita test-workflow-e2e",
    "workflow:validate": "bun skills/orbita/lib/entrypoints/cli/validate-workflow.mjs workflows",
    "validate": "bun run depcruise:check && bun run role-evidence:check && bun run test && bun run workflow:validate && bun run agents:check && bun run schema-validation:check-vendor-ajv",
    "prepare": "git config core.hooksPath .githooks || true",
    "schema-validation:bundle-vendor-ajv": "bun scripts/bundle-schema-validation-vendor-ajv.mjs",
    "schema-validation:check-vendor-ajv": "bun run schema-validation:bundle-vendor-ajv && git diff --exit-code -- shared/scripts/schema-validation/vendor/ajv.mjs && test -z \"$(git status --porcelain -- shared/scripts/schema-validation/vendor/ajv.mjs)\"",
    "maintain:bundle-schema-validation-vendor-ajv": "bun run schema-validation:bundle-vendor-ajv",
    "agents:generate": "bun scripts/generate-codex-agents.mjs",
    "dashboard:build": "vite build --config skills/orbita/lib/dashboard/ui/vite.config.mjs",
    "dashboard:typecheck": "tsc -p skills/orbita/lib/dashboard/ui/tsconfig.json --noEmit",
    "depcruise:check": "depcruise --config .dependency-cruiser.cjs skills/orbita/lib",
    "agents:check": "bun scripts/check-generated-codex-agents.mjs",
    "role-evidence:check": "python3 scripts/check_role_evidence.py"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "^8.17.1",
    "dependency-cruiser": "18.0.0",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "workspaces": [
    "shared/scripts/schema-validation"
  ],
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@tanstack/router-plugin": "1.168.19",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7"
  }
}
