{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/code-review-orchestrator/review-merge-output",
  "title": "Code Review Orchestrator Merged Review",
  "type": "object",
  "required": [
    "outcome",
    "next",
    "pass_number",
    "verdict",
    "summary",
    "reviewed_branches",
    "must_fix",
    "should_fix",
    "can_delay",
    "disagreements",
    "contract_docs_drift",
    "sensitive_surface_coverage",
    "suggested_next_step"
  ],
  "properties": {
    "outcome": { "enum": ["passed", "failed", "needs_rereview"] },
    "next": { "enum": ["done", "review_intake"] },
    "pass_number": { "type": "integer", "minimum": 1, "maximum": 3 },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "summary": { "$ref": "#/$defs/evidence" },
    "reviewed_branches": { "$ref": "#/$defs/reviewBranches" },
    "must_fix": { "$ref": "#/$defs/mergedFindings" },
    "should_fix": { "$ref": "#/$defs/mergedFindings" },
    "can_delay": { "$ref": "#/$defs/mergedFindings" },
    "disagreements": {
      "type": "array",
      "items": { "$ref": "#/$defs/disagreement" }
    },
    "contract_docs_drift": { "$ref": "#/$defs/contractDocsDrift" },
    "sensitive_surface_coverage": { "$ref": "#/$defs/sensitiveSurfaceCoverage" },
    "suggested_next_step": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "type": "object", "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": {
          "next": { "const": "done" },
          "verdict": { "const": "PASS" },
          "must_fix": { "type": "array", "maxItems": 0 },
          "should_fix": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "outcome": { "const": "failed" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": { "next": { "const": "done" }, "verdict": { "const": "FAIL" } },
        "anyOf": [
          { "type": "object", "properties": { "must_fix": { "type": "array", "minItems": 1 } } },
          { "type": "object", "properties": { "should_fix": { "type": "array", "minItems": 1 } } }
        ]
      }
    },
    {
      "if": { "type": "object", "properties": { "outcome": { "const": "needs_rereview" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": { "next": { "const": "review_intake" }, "verdict": { "const": "FAIL" } },
        "anyOf": [
          { "type": "object", "properties": { "must_fix": { "type": "array", "minItems": 1 } } },
          { "type": "object", "properties": { "should_fix": { "type": "array", "minItems": 1 } } }
        ]
      }
    },
    {
      "if": { "type": "object", "properties": { "pass_number": { "const": 3 } }, "required": ["pass_number"] },
      "then": {
        "type": "object",
        "properties": { "outcome": { "enum": ["passed", "failed"] }, "next": { "const": "done" } }
      }
    }
  ],
  "$defs": {
    "reviewBranch": {
      "enum": [
        "critic_review",
        "architect_review",
        "backend_review",
        "frontend_review",
        "frontend_taste_review",
        "security_review",
        "privacy_review",
        "qa_review",
        "performance_review"
      ]
    },
    "role": {
      "enum": [
        "critic",
        "architect",
        "backend",
        "frontend",
        "frontend taste",
        "security",
        "privacy/data-safety",
        "qa/reliability",
        "performance"
      ]
    },
    "reviewBranches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reviewBranch" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "mergedFinding": {
      "type": "object",
      "required": ["summary", "location", "mechanism", "impact", "evidence", "tests_gap", "required_next_action", "reviewers", "confidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "tests_gap": { "type": "string", "minLength": 1 },
        "required_next_action": { "type": "string", "minLength": 1 },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "confidence": { "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    },
    "mergedFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/mergedFinding" }
    },
    "disagreement": {
      "type": "object",
      "required": ["topic", "positions", "missing_evidence"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "positions": { "$ref": "#/$defs/evidence" },
        "missing_evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contractDocsDrift": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["cleared", "failed", "not_required"] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "sensitiveSurfaceCoverage": {
      "type": "object",
      "required": ["privacy_data_safety", "security", "cleared_by", "evidence"],
      "properties": {
        "privacy_data_safety": { "enum": ["cleared", "failed", "not_run", "not_required"] },
        "security": { "enum": ["cleared", "failed", "not_run", "not_required"] },
        "cleared_by": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["privacy/data-safety", "security"] }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    }
  }
}
