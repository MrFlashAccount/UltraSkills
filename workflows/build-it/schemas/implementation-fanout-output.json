{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/build-it/implementation-fanout-output",
  "title": "Build It Development Packet",
  "description": "Verified development handoff routed either to internal hostile-prior review or directly back to the implementation approval gate after user-requested rework.",
  "type": "object",
  "required": [
    "outcome",
    "summary",
    "repo",
    "issue_url",
    "status",
    "implementer_owners",
    "execution_contract_basis",
    "branch_name",
    "pr_url",
    "change_summary",
    "verification_results",
    "review_handoff",
    "warnings",
    "next_action",
    "issue_comment"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "ready_for_review",
        "ready_for_user_approval"
      ],
      "description": "Runner routing discriminator required for worker output."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "issue_url": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready_for_review",
        "ready_for_user_approval"
      ]
    },
    "implementer_owners": {
      "$ref": "#/$defs/ownerMap"
    },
    "execution_contract_basis": {
      "type": "string",
      "minLength": 1
    },
    "branch_name": {
      "type": "string"
    },
    "pr_url": {
      "type": "string"
    },
    "change_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/verificationResult"
      }
    },
    "review_branches": {
      "$ref": "#/$defs/reviewBranches",
      "description": "Exact reviewer branches for the next internal review activation."
    },
    "reviewer_handoffs": {
      "$ref": "#/$defs/reviewerHandoffs",
      "description": "Reviewer-specific evidence keyed by selected review branch id."
    },
    "review_handoff": {
      "type": "object",
      "required": [
        "prior",
        "review_status",
        "reviewer_plan",
        "hotspots",
        "contract_gaps",
        "resolved_proof_obligations",
        "architecture_contract_deviations",
        "unresolved_compatibility_surfaces",
        "negative_checks_run"
      ],
      "properties": {
        "prior": {
          "const": "hostile_prior"
        },
        "review_status": {
          "enum": [
            "pending",
            "user_rework_not_reviewed"
          ]
        },
        "reviewer_plan": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "hotspots": {
          "$ref": "#/$defs/stringArray"
        },
        "contract_gaps": {
          "$ref": "#/$defs/stringArray"
        },
        "resolved_proof_obligations": {
          "$ref": "#/$defs/stringArray"
        },
        "architecture_contract_deviations": {
          "$ref": "#/$defs/stringArray"
        },
        "unresolved_compatibility_surfaces": {
          "$ref": "#/$defs/stringArray"
        },
        "negative_checks_run": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "issue_comment": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready_for_review"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "review_branches",
          "reviewer_handoffs"
        ],
        "properties": {
          "status": {
            "const": "ready_for_review"
          },
          "review_handoff": {
            "type": "object",
            "properties": {
              "review_status": {
                "const": "pending"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready_for_user_approval"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "review_branches"
              ]
            },
            {
              "required": [
                "reviewer_handoffs"
              ]
            }
          ]
        },
        "properties": {
          "status": {
            "const": "ready_for_user_approval"
          },
          "review_handoff": {
            "type": "object",
            "properties": {
              "review_status": {
                "const": "user_rework_not_reviewed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "architect_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "architect_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "backend_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "backend_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "frontend_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "frontend_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "frontend_taste_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "frontend_taste_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "security_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "security_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "privacy_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "privacy_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "qa_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "qa_review"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewBranches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "architect_review",
          "backend_review",
          "frontend_review",
          "frontend_taste_review",
          "security_review",
          "privacy_review",
          "qa_review"
        ]
      }
    },
    "reviewerHandoffs": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "architect_review": {
          "$ref": "#/$defs/reviewerHandoff"
        },
        "backend_review": {
          "$ref": "#/$defs/reviewerHandoff"
        },
        "frontend_review": {
          "$ref": "#/$defs/reviewerHandoff"
        },
        "frontend_taste_review": {
          "$ref": "#/$defs/reviewerHandoff"
        },
        "security_review": {
          "$ref": "#/$defs/reviewerHandoff"
        },
        "privacy_review": {
          "$ref": "#/$defs/reviewerHandoff"
        },
        "qa_review": {
          "$ref": "#/$defs/reviewerHandoff"
        }
      },
      "additionalProperties": false
    },
    "reviewerHandoff": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "ownerMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "properties": {
        "backend": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "frontend": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "architect": {
          "$ref": "#/$defs/stringArray",
          "minItems": 1,
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "verificationResult": {
      "type": "object",
      "required": [
        "implementer_owner",
        "check",
        "result",
        "evidence",
        "role_material_requirements_satisfied"
      ],
      "properties": {
        "implementer_owner": {
          "enum": [
            "backend",
            "frontend",
            "architect"
          ]
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "passed"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "role_material_requirements_satisfied": {
          "const": true
        },
        "gaps": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    }
  }
}
