{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/dev-harness/review-fanout-output",
  "title": "Review Fanout Owner Output",
  "description": "Owner-worker decision after the selected review branches finish.",
  "type": "object",
  "required": [
    "outcome",
    "verdict"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "approved",
        "needs_changes"
      ],
      "description": "Aggregate result for the current review activation.",
      "x-usage": "Use needs_changes for any actionable current-scope must-fix or should-fix finding."
    },
    "implementation_branches": {
      "$ref": "#/$defs/implementationBranches",
      "description": "Exact implementation branches required for the next rework activation.",
      "x-usage": "Use as the first implementation.input.branches candidate on re-entry."
    },
    "review_branches": {
      "$ref": "#/$defs/reviewBranches",
      "description": "Mandatory reviewer baseline after the prescribed rework.",
      "x-usage": "The implementation owner may widen this baseline after actual changes but must not remove entries."
    },
    "implementer_handoffs": {
      "$ref": "#/$defs/implementerHandoffs",
      "description": "Actionable reviewer findings grouped by required implementation branch.",
      "x-usage": "Each rerun implementation branch reads only its matching handoff and current approved contracts."
    },
    "verdict": {
      "$ref": "#/$defs/verdict",
      "description": "Compact aggregate review evidence.",
      "x-usage": "Use as the final approval-gate context on approved and as rework evidence on needs_changes."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"
      },
      "description": "Optional owner-produced artifact metadata.",
      "x-usage": "Keep large review evidence file-backed and emit only central artifact metadata here."
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Optional compact owner result records.",
      "x-usage": "Use only for bounded machine-readable summaries."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "approved"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "verdict"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "implementation_branches"
              ]
            },
            {
              "required": [
                "review_branches"
              ]
            },
            {
              "required": [
                "implementer_handoffs"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "needs_changes"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "implementation_branches",
          "review_branches",
          "implementer_handoffs",
          "verdict"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "implementation_branches": {
            "type": "array",
            "contains": {
              "const": "backend_implementation"
            }
          }
        },
        "required": [
          "implementation_branches"
        ]
      },
      "then": {
        "properties": {
          "implementer_handoffs": {
            "type": "object",
            "required": [
              "backend_implementation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation_branches": {
            "type": "array",
            "contains": {
              "const": "frontend_implementation"
            }
          }
        },
        "required": [
          "implementation_branches"
        ]
      },
      "then": {
        "properties": {
          "implementer_handoffs": {
            "type": "object",
            "required": [
              "frontend_implementation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation_branches": {
            "type": "array",
            "contains": {
              "const": "architecture_artifact_update"
            }
          }
        },
        "required": [
          "implementation_branches"
        ]
      },
      "then": {
        "properties": {
          "implementer_handoffs": {
            "type": "object",
            "required": [
              "architecture_artifact_update"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "implementationBranches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "backend_implementation",
          "frontend_implementation",
          "architecture_artifact_update"
        ]
      }
    },
    "reviewBranches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "architect_review",
          "backend_review",
          "frontend_review",
          "frontend_taste_review",
          "security_review",
          "privacy_review",
          "qa_review"
        ]
      }
    },
    "implementerHandoffs": {
      "type": "object",
      "properties": {
        "backend_implementation": {
          "$ref": "#/$defs/handoff"
        },
        "frontend_implementation": {
          "$ref": "#/$defs/handoff"
        },
        "architecture_artifact_update": {
          "$ref": "#/$defs/handoff"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "verdict": {
      "type": "object",
      "required": [
        "summary",
        "reviewed_branches",
        "failed_review_branches",
        "findings"
      ],
      "properties": {
        "summary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewed_branches": {
          "$ref": "#/$defs/reviewBranches"
        },
        "failed_review_branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "architect_review",
              "backend_review",
              "frontend_review",
              "frontend_taste_review",
              "security_review",
              "privacy_review",
              "qa_review"
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Aggregated actionable findings shown at the final user implementation gate; empty only for a clean approved review.",
          "x-usage": "Present these as reviewer context at the user gate and preserve them when the automated review loop exhausts; do not silently downgrade or discard them."
        }
      },
      "additionalProperties": true
    }
  }
}
