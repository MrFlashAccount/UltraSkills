{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/make-it-fast/hypothesis-output",
  "type": "object",
  "required": ["outcome", "mechanism", "target", "expected_metric_movement", "edit_surface", "correctness_risks", "falsifier", "rollback"],
  "properties": {
    "outcome": {"const": "ready_for_implementation"},
    "mechanism": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "expected_metric_movement": {"type": "string", "minLength": 1},
    "edit_surface": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "correctness_risks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "falsifier": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
