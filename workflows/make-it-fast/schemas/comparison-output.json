{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/make-it-fast/comparison-output",
  "type": "object",
  "required": ["outcome", "valid", "method", "environment_parity", "raw_samples", "aggregate", "baseline_aggregate", "delta", "threshold_met", "correctness", "variance_notes"],
  "properties": {
    "outcome": {"enum": ["improved", "not_improved", "invalid"]},
    "valid": {"type": "boolean"},
    "method": {"type": "string", "minLength": 1},
    "environment_parity": {"type": "string", "minLength": 1},
    "raw_samples": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "aggregate": {"type": "string", "minLength": 1},
    "baseline_aggregate": {"type": "string", "minLength": 1},
    "delta": {"type": "string", "minLength": 1},
    "threshold_met": {"type": "boolean"},
    "correctness": {"type": "string", "minLength": 1},
    "variance_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "invalid"}}, "required": ["outcome"]}, "then": {"properties": {"valid": {"const": false}}}},
    {"if": {"properties": {"outcome": {"const": "improved"}}, "required": ["outcome"]}, "then": {"properties": {"valid": {"const": true}, "threshold_met": {"const": true}}}}
  ]
}
