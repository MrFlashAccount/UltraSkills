{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/make-it-fast/implementation-output",
  "type": "object",
  "required": ["outcome", "summary", "mechanism_implemented", "changed_files", "correctness_checks", "remaining_risks"],
  "properties": {
    "outcome": {"const": "ready_for_comparison"},
    "summary": {"type": "string", "minLength": 1},
    "mechanism_implemented": {"type": "string", "minLength": 1},
    "changed_files": {"$ref": "#/$defs/strings"},
    "correctness_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "remaining_risks": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
