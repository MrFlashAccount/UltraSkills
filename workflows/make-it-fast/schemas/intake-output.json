{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/make-it-fast/intake-output",
  "type": "object",
  "required": ["outcome", "workload", "primary_metric", "correctness_guard", "measurement_method", "environment_controls", "sample_policy", "success_threshold", "edit_boundary", "stop_conditions"],
  "properties": {
    "outcome": {"const": "ready"},
    "workload": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "correctness_guard": {"type": "string", "minLength": 1},
    "measurement_method": {"type": "string", "minLength": 1},
    "environment_controls": {"$ref": "#/$defs/strings"},
    "sample_policy": {"type": "string", "minLength": 1},
    "success_threshold": {"type": "string", "minLength": 1},
    "edit_boundary": {"$ref": "#/$defs/strings"},
    "stop_conditions": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {"strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
