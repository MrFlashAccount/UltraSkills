{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/make-it-fast/baseline-output",
  "type": "object",
  "required": ["outcome", "valid", "method", "environment", "raw_samples", "aggregate", "correctness", "profile_evidence", "dominant_cost"],
  "properties": {
    "outcome": {"const": "ready_for_hypothesis"},
    "valid": {"const": true},
    "method": {"type": "string", "minLength": 1},
    "environment": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "raw_samples": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "aggregate": {"type": "string", "minLength": 1},
    "correctness": {"type": "string", "minLength": 1},
    "profile_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dominant_cost": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
