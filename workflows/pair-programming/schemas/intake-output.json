{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/pair-programming/intake-output",
  "type": "object",
  "required": ["outcome", "mode", "driver_scope", "navigator_scope", "integration_owner", "success_checks", "forbidden_overlaps"],
  "properties": {
    "outcome": {"const": "ready"},
    "mode": {"enum": ["disjoint_zones", "shared_zone"]},
    "driver_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "navigator_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "integration_owner": {"const": "pair_integrator"},
    "success_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_overlaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
