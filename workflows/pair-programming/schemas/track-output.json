{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/pair-programming/track-output",
  "type": "object",
  "required": ["outcome", "track", "candidate_kind", "summary", "evidence", "changed_files", "verification", "decisions", "disagreements"],
  "properties": {
    "outcome": {"const": "ready_for_integration"},
    "track": {"enum": ["driver", "navigator"]},
    "candidate_kind": {"enum": ["implementation", "read_only_guidance"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"$ref": "#/$defs/strings"},
    "changed_files": {"$ref": "#/$defs/strings"},
    "verification": {"$ref": "#/$defs/strings"},
    "decisions": {"$ref": "#/$defs/strings"},
    "disagreements": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
