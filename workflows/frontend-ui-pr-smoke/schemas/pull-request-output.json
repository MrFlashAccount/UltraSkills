{
  "title": "Frontend UI PR Smoke Pull Request Output",
  "description": "Output contract for the final pull request step in the frontend UI PR smoke workflow.",
  "type": "object",
  "required": [
    "outcome"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "opened",
        "blocked"
      ],
      "description": "Whether the pull request was opened or the workflow hit a recoverable blocker."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable PR summary or preparation status."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Branch used for the pull request."
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "description": "Commit SHA or short commit reference for the PR."
    },
    "pr_url": {
      "type": "string",
      "minLength": 1,
      "description": "Pull request URL when outcome is opened."
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "blocker": {
      "type": "object",
      "required": [
        "summary",
        "source_step_id",
        "needed"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_step_id": {
          "type": "string",
          "minLength": 1
        },
        "needed": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/frontend-ui-pr-smoke/pull-request-output",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "opened"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "summary",
          "branch",
          "commit",
          "pr_url",
          "verification"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "blocker"
        ]
      }
    }
  ]
}
