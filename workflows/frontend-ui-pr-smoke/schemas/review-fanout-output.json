{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/frontend-ui-pr-smoke/review-fanout-output",
  "title": "Frontend UI Smoke Review Fanout Output",
  "type": "object",
  "required": ["outcome"],
  "properties": {
    "outcome": { "enum": ["passed", "needs_changes", "blocked"] },
    "next": { "enum": ["implementation", "pull_request"] },
    "implementation_branches": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "const": "frontend_implementation" }
    },
    "review_branches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["frontend_review", "frontend_taste_review"] }
    },
    "implementer_handoffs": {
      "type": "object",
      "properties": {
        "frontend_implementation": { "type": "object", "minProperties": 1, "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "verdict": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "blocker": {
      "type": "object",
      "required": ["summary", "source_step_id", "needed"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source_step_id": { "const": "review" },
        "needed": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "risk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
      "then": {
        "required": ["next", "verdict"],
        "properties": { "next": { "const": "pull_request" } },
        "not": { "anyOf": [{ "required": ["implementation_branches"] }, { "required": ["review_branches"] }, { "required": ["implementer_handoffs"] }] }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "needs_changes" } }, "required": ["outcome"] },
      "then": {
        "required": ["next", "implementation_branches", "review_branches", "implementer_handoffs", "verdict"],
        "properties": {
          "next": { "const": "implementation" },
          "implementer_handoffs": { "type": "object", "required": ["frontend_implementation"] }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "blocked" } }, "required": ["outcome"] },
      "then": { "required": ["blocker"], "not": { "required": ["next"] } },
      "else": { "not": { "required": ["blocker"] } }
    }
  ]
}
