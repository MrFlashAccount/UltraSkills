{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/frontend-ui-pr-smoke/design-draft-output",
  "title": "Frontend UI Smoke Design Draft Output",
  "type": "object",
  "required": ["outcome"],
  "properties": {
    "outcome": { "enum": ["ready_for_attack", "ready_for_approval", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "contains": {
        "type": "object",
        "required": ["id", "content_type"],
        "properties": {
          "id": { "const": "ui-design-proposal" },
          "content_type": { "const": "text/html" }
        }
      },
      "items": { "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact" }
    },
    "blocker": {
      "type": "object",
      "required": ["summary", "source_step_id", "needed"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source_step_id": { "const": "design_draft" },
        "needed": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "risk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["ready_for_attack", "ready_for_approval"] } }, "required": ["outcome"] },
      "then": { "required": ["summary", "artifacts"] }
    },
    {
      "if": { "properties": { "outcome": { "const": "blocked" } }, "required": ["outcome"] },
      "then": { "required": ["blocker"] },
      "else": { "not": { "required": ["blocker"] } }
    }
  ]
}
