{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/frontend-ui-pr-smoke/design-draft-output",
  "title": "Frontend UI Smoke Design Draft Output",
  "type": "object",
  "required": ["outcome"],
  "properties": {
    "outcome": {
      "enum": ["ready_for_attack", "ready_for_approval"],
      "description": "Completed design draft state. Report missing help through the runner non-blocking stop control channel, never as an output outcome."
    },
    "summary": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "contains": {
        "type": "object",
        "required": ["id", "content_type"],
        "properties": {
          "id": { "const": "ui-design-proposal" },
          "content_type": { "const": "text/html" }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "allOf": [
        {
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": ["id", "content_type"],
                "properties": {
                  "id": { "const": "ui-design-proposal" },
                  "content_type": { "const": "text/html" }
                }
              },
              {
                "type": "object",
                "required": ["content_type"],
                "properties": {
                  "content_type": {
                    "enum": ["image/png", "image/jpeg", "image/webp"]
                  }
                }
              }
            ]
          }
        }
      ],
      "items": { "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["ready_for_attack", "ready_for_approval"] } }, "required": ["outcome"] },
      "then": { "required": ["summary", "artifacts"] }
    }
  ]
}
