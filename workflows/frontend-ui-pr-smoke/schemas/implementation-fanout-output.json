{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/frontend-ui-pr-smoke/implementation-fanout-output",
  "title": "Frontend UI Smoke Implementation Fanout Output",
  "type": "object",
  "required": ["outcome"],
  "properties": {
    "outcome": { "enum": ["ready_for_review", "blocked"] },
    "review_branches": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["frontend_review", "frontend_taste_review"] }
    },
    "reviewer_handoffs": {
      "type": "object",
      "properties": {
        "frontend_review": { "type": "object", "minProperties": 1, "additionalProperties": true },
        "frontend_taste_review": { "type": "object", "minProperties": 1, "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": ["summary", "source_step_id", "needed"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source_step_id": { "const": "implementation" },
        "needed": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "risk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "ready_for_review" } }, "required": ["outcome"] },
      "then": {
        "required": ["review_branches", "reviewer_handoffs"],
        "properties": {
          "reviewer_handoffs": { "type": "object", "required": ["frontend_review", "frontend_taste_review"] }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "blocked" } }, "required": ["outcome"] },
      "then": { "required": ["blocker"] },
      "else": { "not": { "required": ["blocker"] } }
    }
  ]
}
