{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/red-green-refactor/cycle-output",
  "type": "object",
  "required": ["outcome", "summary", "red", "green", "refactor", "fast", "changed_files", "verification", "remaining_risks"],
  "properties": {
    "outcome": {"const": "ready_for_review"},
    "summary": {"type": "string", "minLength": 1},
    "red": {"$ref": "#/$defs/phase"},
    "green": {"$ref": "#/$defs/phase"},
    "refactor": {"$ref": "#/$defs/optionalPhase"},
    "fast": {"$ref": "#/$defs/optionalPhase"},
    "changed_files": {"$ref": "#/$defs/strings"},
    "verification": {"$ref": "#/$defs/checks"},
    "remaining_risks": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "result"], "properties": {"command": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "phase": {"type": "object", "required": ["action", "evidence"], "properties": {"action": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "optionalPhase": {"type": "object", "required": ["status", "reason", "evidence"], "properties": {"status": {"enum": ["completed", "skipped"]}, "reason": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}
  }
}
