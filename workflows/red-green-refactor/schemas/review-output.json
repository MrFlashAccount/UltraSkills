{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/red-green-refactor/review-output",
  "type": "object",
  "required": ["outcome", "next", "summary", "evidence_checked", "findings"],
  "properties": {
    "outcome": {"enum": ["passed", "needs_revision"]},
    "next": {"enum": ["cycle", "done"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence_checked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "finding", "evidence", "required_action"], "properties": {"severity": {"enum": ["must_fix", "should_fix", "can_delay"]}, "finding": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "required_action": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]}, "then": {"properties": {"next": {"const": "done"}}}},
    {"if": {"properties": {"outcome": {"const": "needs_revision"}}, "required": ["outcome"]}, "then": {"properties": {"next": {"const": "cycle"}, "findings": {"type": "array", "minItems": 1}}}}
  ]
}
