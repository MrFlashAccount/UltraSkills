{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/research-critic/research-attack-output",
  "title": "Research Attack Output",
  "description": "Typed hostile Researcher review of the latest reasons-canvas-research artifact.",
  "type": "object",
  "required": [
    "outcome",
    "verdict"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "approved",
        "needs_revision"
      ],
      "description": "Authoritative routing state for the hostile research attack."
    },
    "verdict": {
      "type": "object",
      "required": [
        "summary",
        "evidence_checked",
        "findings"
      ],
      "properties": {
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/result"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "finding",
        "evidence",
        "required_next_action"
      ],
      "properties": {
        "severity": {
          "enum": [
            "must_fix",
            "should_fix",
            "can_delay"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "required_next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "approved"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "type": "object",
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "needs_revision"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "type": "object",
            "properties": {
              "findings": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
