{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/research-critic/save-research-canvas-output",
  "title": "Research Critic Save Research Canvas Output",
  "description": "Neutral reusable output contract for final research Canvas persistence metadata.",
  "type": "object",
  "required": [
    "outcome",
    "saved",
    "artifacts",
    "results"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "saved"
      ],
      "description": "Authoritative routing state for final persistence."
    },
    "saved": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "history_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"
      },
      "minItems": 1,
      "maxItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "const": "reasons-canvas-research"
          }
        }
      },
      "description": "Saved artifact metadata for the required approved reasons-canvas-research artifact.",
      "x-usage": "Use artifact files as the source of truth for human-facing research content and required REASONS research Canvas content; structured JSON remains for workflow branching. Exact artifact field semantics come from the shared baton artifact schema."
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/result"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "saved"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "saved",
          "artifacts",
          "results"
        ]
      }
    }
  ]
}
