{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/spdd/implementation-fanout-output",
  "title": "Implementation Fanout Owner Output",
  "description": "Owner-worker output after the selected implementation branches finish.",
  "type": "object",
  "required": [
    "outcome",
    "summary",
    "artifacts"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "ready_for_review",
        "ready_for_user_approval"
      ],
      "description": "Owner decision for the completed implementation activation.",
      "x-usage": "Use ready_for_review for the initial or reviewer-requested implementation pass. Use ready_for_user_approval after user-requested rework so the result returns directly to the same approval gate."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Concise user-facing summary of the latest completed implementation activation.",
      "x-usage": "Use this as the implementation approval summary; include addressed user feedback when the outcome is ready_for_user_approval."
    },
    "review_branches": {
      "$ref": "#/$defs/reviewBranches",
      "description": "Exact reviewer branch ids for the next review activation.",
      "x-usage": "Use as review.input.branches. It must include the mandatory baseline and any owner-approved widening."
    },
    "reviewer_handoffs": {
      "$ref": "#/$defs/reviewerHandoffs",
      "description": "Reviewer-specific implementation evidence keyed by selected review branch id.",
      "x-usage": "Each selected reviewer reads only its matching handoff plus approved plan evidence."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"
      },
      "description": "Implementation handoff artifact metadata copied from every selected implementation branch.",
      "x-usage": "Attach these handoffs at the user implementation gate; do not merge or embed their bodies in owner JSON."
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Optional compact owner result records.",
      "x-usage": "Use only for bounded machine-readable summaries."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready_for_review"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "review_branches",
          "reviewer_handoffs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready_for_user_approval"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "review_branches"
              ]
            },
            {
              "required": [
                "reviewer_handoffs"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "architect_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "architect_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "backend_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "backend_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "frontend_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "frontend_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "frontend_taste_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "frontend_taste_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "security_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "security_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "privacy_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "privacy_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_branches": {
            "type": "array",
            "contains": {
              "const": "qa_review"
            }
          }
        },
        "required": [
          "review_branches"
        ]
      },
      "then": {
        "properties": {
          "reviewer_handoffs": {
            "type": "object",
            "required": [
              "qa_review"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "reviewBranches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "architect_review",
          "backend_review",
          "frontend_review",
          "frontend_taste_review",
          "security_review",
          "privacy_review",
          "qa_review"
        ]
      }
    },
    "reviewerHandoffs": {
      "type": "object",
      "properties": {
        "architect_review": {
          "$ref": "#/$defs/handoff"
        },
        "backend_review": {
          "$ref": "#/$defs/handoff"
        },
        "frontend_review": {
          "$ref": "#/$defs/handoff"
        },
        "frontend_taste_review": {
          "$ref": "#/$defs/handoff"
        },
        "security_review": {
          "$ref": "#/$defs/handoff"
        },
        "privacy_review": {
          "$ref": "#/$defs/handoff"
        },
        "qa_review": {
          "$ref": "#/$defs/handoff"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  }
}
