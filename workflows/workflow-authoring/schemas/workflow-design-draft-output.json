{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "outcome"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "ready_for_attack",
        "ready_for_approval"
      ]
    },
    "workflow_contract": {
      "type": "object"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"
      },
      "contains": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "const": "workflow-contract"
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ready_for_attack",
              "ready_for_approval"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "workflow_contract",
          "summary",
          "artifacts"
        ]
      }
    }
  ]
}
