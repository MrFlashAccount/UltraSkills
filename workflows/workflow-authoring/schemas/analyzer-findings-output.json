{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Authoring Analyzer Findings Output",
  "type": "object",
  "required": [
    "outcome",
    "summary",
    "artifacts"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "ready_for_review",
        "no_changes"
      ],
      "description": "Analyzer recommendation state. Findings cannot authorize edits directly."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_path",
          "affected_contract_surface",
          "severity",
          "next_action",
          "edit_authorized"
        ],
        "properties": {
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "affected_contract_surface": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "edit_authorized": {
            "const": false,
            "description": "Analyzer findings are evidence-backed recommendations only; edits require approve_reviewed_improvement."
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready_for_review"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "reviewed-improvement"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ready_for_review",
              "no_changes"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "findings"
        ]
      }
    }
  ]
}
