{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/loop/loop-intake-output",
  "title": "Loop Intake Output",
  "description": "Normalized executable loop request and initial compact durable baton.",
  "type": "object",
  "required": ["outcome", "baton"],
  "properties": {
    "outcome": {"const": "ready"},
    "baton": {"$ref": "#/$defs/initialBaton"}
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "artifacts": {
      "type": "object",
      "required": ["files", "prs", "issues", "notes"],
      "properties": {
        "files": {"$ref": "#/$defs/stringList"},
        "prs": {"$ref": "#/$defs/stringList"},
        "issues": {"$ref": "#/$defs/stringList"},
        "notes": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    },
    "initialBaton": {
      "type": "object",
      "required": ["loop_id", "task", "requested_max_iterations", "max_iterations", "runtime_max_iterations", "limit_mismatch", "saturation_limit", "iteration", "iterations_completed", "success_criteria", "stop_conditions", "help_conditions", "verification_requirements", "executor_constraints", "last_result", "next_action", "no_progress_count", "open_risks", "artifacts", "verification", "cycle_summaries", "retry_context", "approval_boundaries", "resolved_help_conditions", "user_stop_requested"],
      "properties": {
        "loop_id": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "requested_max_iterations": {"type": "integer", "minimum": 1},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 3},
        "runtime_max_iterations": {"const": 3},
        "limit_mismatch": {"type": ["string", "null"], "minLength": 1},
        "saturation_limit": {"type": "integer", "minimum": 1, "maximum": 3},
        "iteration": {"const": 1},
        "iterations_completed": {"const": 0},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "help_conditions": {"$ref": "#/$defs/stringList"},
        "verification_requirements": {"$ref": "#/$defs/stringList"},
        "executor_constraints": {"$ref": "#/$defs/executorConstraints"},
        "last_result": {
          "type": "object",
          "required": ["status", "summary", "evidence", "artifacts", "verification"],
          "properties": {
            "status": {"const": "none"},
            "summary": {"const": "none yet"},
            "evidence": {"type": "array", "maxItems": 0},
            "artifacts": {"$ref": "#/$defs/artifacts"},
            "verification": {"type": "array", "maxItems": 0}
          },
          "additionalProperties": false
        },
        "next_action": {"type": "string", "minLength": 1},
        "no_progress_count": {"const": 0},
        "open_risks": {"$ref": "#/$defs/stringList"},
        "artifacts": {"$ref": "#/$defs/artifacts"},
        "verification": {"type": "array", "maxItems": 0},
        "cycle_summaries": {"type": "array", "maxItems": 0},
        "retry_context": {"type": "null"},
        "approval_boundaries": {"$ref": "#/$defs/stringList"},
        "resolved_help_conditions": {"type": "array", "maxItems": 0},
        "user_stop_requested": {"const": false}
      },
      "additionalProperties": false
    },
    "executorConstraints": {
      "type": "object",
      "required": ["allowed_tools", "write_scope", "external_actions", "target_scope", "reporting_requirements"],
      "properties": {
        "allowed_tools": {"$ref": "#/$defs/stringList"},
        "write_scope": {"$ref": "#/$defs/stringList"},
        "external_actions": {"$ref": "#/$defs/stringList"},
        "target_scope": {"$ref": "#/$defs/stringList"},
        "reporting_requirements": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    }
  }
}
