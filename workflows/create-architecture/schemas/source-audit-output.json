{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/create-architecture/source-audit-output",
  "title": "Create Architecture Source Audit Output",
  "type": "object",
  "required": [
    "outcome",
    "mode",
    "implementation_scope",
    "architecture_generation_mode",
    "proposal_generation_step",
    "next_step",
    "summary",
    "representative_asks",
    "architecture_change_needed",
    "current_shape",
    "missing_evidence",
    "constraints",
    "pressure_points"
  ],
  "properties": {
    "outcome": {"enum": ["audit_complete", "ready_for_context"]},
    "mode": {"enum": ["audit", "scaffold", "improve"]},
    "subtype": {"const": "align"},
    "implementation_scope": {"enum": ["proposal_only", "implement"]},
    "architecture_generation_mode": {"enum": ["direct", "dialectic"]},
    "proposal_generation_step": {"enum": ["architecture_proposal", "proposal_dialectic_positions"]},
    "next_step": {"enum": ["done", "context_recovery", "proposal_dialectic_positions"]},
    "summary": {"type": "string", "minLength": 1},
    "representative_asks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "architecture_change_needed": {"type": "boolean"},
    "current_shape": {"type": "string", "minLength": 1},
    "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "pressure_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"},
            {"type": "object", "required": ["id", "content_type"], "properties": {"id": {"const": "create-architecture-dialectic-input"}, "content_type": {"const": "application/json"}}}
          ]
        }
      ],
      "items": false
    },
    "evolution_slice_needed": {"type": "boolean"},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommendation": {"enum": ["stop", "scaffold_next", "improve_next", "continue"]},
    "results": {
      "type": "array",
      "items": {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/result"}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "audit_complete"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "mode": {"const": "audit"},
          "implementation_scope": {"const": "proposal_only"}
        },
        "required": ["findings", "recommendation"]
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "ready_for_context"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "mode": {"enum": ["scaffold", "improve"]},
          "recommendation": {"const": "continue"}
        },
        "required": ["recommendation"]
      }
    },
    {
      "if": {"properties": {"subtype": {"const": "align"}}, "required": ["subtype"]},
      "then": {"properties": {"mode": {"const": "improve"}}}
    },
    {
      "if": {"properties": {"architecture_generation_mode": {"const": "direct"}}, "required": ["architecture_generation_mode"]},
      "then": {"properties": {"proposal_generation_step": {"const": "architecture_proposal"}}}
    },
    {
      "if": {"properties": {"architecture_generation_mode": {"const": "dialectic"}}, "required": ["architecture_generation_mode"]},
      "then": {"properties": {"proposal_generation_step": {"const": "proposal_dialectic_positions"}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "ready_for_context"}}, "required": ["outcome"]},
      "then": {"properties": {"next_step": {"const": "context_recovery"}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "audit_complete"}, "architecture_generation_mode": {"const": "direct"}}, "required": ["outcome", "architecture_generation_mode"]},
      "then": {"properties": {"next_step": {"const": "done"}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "audit_complete"}, "architecture_generation_mode": {"const": "dialectic"}}, "required": ["outcome", "architecture_generation_mode"]},
      "then": {"required": ["artifacts"], "properties": {"next_step": {"const": "proposal_dialectic_positions"}}}
    }
  ]
}
