{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/create-design/design-review-output",
  "type": "object",
  "required": ["outcome", "mode", "summary", "findings"],
  "properties": {
    "outcome": {"const": "review_complete"},
    "mode": {"const": "review"},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"}},
    "results": {"type": "array", "items": {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/result"}}
  },
  "additionalProperties": false
}
