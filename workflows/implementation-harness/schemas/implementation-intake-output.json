{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/implementation-harness/implementation-intake-output",
  "title": "Implementation Harness Intake Output",
  "description": "Normalized approved task, research, execution-plan, and backend/frontend routing input.",
  "type": "object",
  "required": [
    "outcome",
    "approval_status",
    "approved_task_context",
    "approved_research",
    "approved_execution_plan",
    "implementer_owners",
    "selected_implementation_steps"
  ],
  "properties": {
    "outcome": {
      "const": "ready_for_implementation",
      "description": "Runner routing state after approved input and ownership are complete."
    },
    "approval_status": {
      "const": "approved"
    },
    "approved_task_context": {
      "type": "object",
      "required": ["goal", "non_goals", "acceptance_criteria", "repo", "issue_url"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "non_goals": { "$ref": "#/$defs/stringArray" },
        "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStringArray" },
        "repo": { "type": "string", "minLength": 1 },
        "issue_url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "approved_research": {
      "type": "object",
      "required": [
        "closed_proposal",
        "facts",
        "evidence",
        "risks",
        "unresolved_blockers_status",
        "design_test_need"
      ],
      "properties": {
        "closed_proposal": { "type": "string", "minLength": 1 },
        "facts": { "$ref": "#/$defs/stringArray" },
        "evidence": { "$ref": "#/$defs/stringArray" },
        "risks": { "$ref": "#/$defs/stringArray" },
        "unresolved_blockers_status": { "type": "string", "minLength": 1 },
        "design_test_need": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approved_execution_plan": {
      "type": "object",
      "required": ["file_zones", "reviewer_plan", "rollback_point", "docs_to_update"],
      "properties": {
        "file_zones": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileZone" },
          "uniqueItems": true
        },
        "reviewer_plan": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "rollback_point": { "type": "string", "minLength": 1 },
        "docs_to_update": { "$ref": "#/$defs/stringArray" },
        "design_test_status_scope": { "type": "string", "minLength": 1 },
        "sensitive_surface_handling": { "type": "string", "minLength": 1 },
        "request_path_contract_touchpoints": { "$ref": "#/$defs/stringArray" },
        "architecture_handoff": {
          "type": "object",
          "properties": {
            "domain_source_proof_map": {},
            "source_layout_owner_map": {},
            "runtime_path_map": {},
            "schema_domain_ownership_map": {},
            "compatibility_surface_plan": {},
            "deletion_migration_plan": {},
            "forbidden_placements_imports": {},
            "verification_surfaces": {},
            "reviewer_gates": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "implementer_owners": { "$ref": "#/$defs/ownerMap" },
    "selected_implementation_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "enum": ["backend_implementation", "frontend_implementation"]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "owner": {
      "enum": ["backend", "frontend"]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fileZone": {
      "type": "object",
      "required": ["zone", "owner"],
      "properties": {
        "zone": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" }
      },
      "additionalProperties": false
    },
    "ownerMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "backend": { "$ref": "#/$defs/nonEmptyStringArray" },
        "frontend": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    }
  }
}
