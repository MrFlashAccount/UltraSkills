{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/deep-debugging/hostile-branch-output",
  "type": "object",
  "required": ["outcome", "branch", "summary", "invalidated_assumptions", "evidence", "sources", "candidate_discriminators", "limitations"],
  "properties": {
    "outcome": {"const": "ready_for_reframe"},
    "branch": {"enum": ["hostile_critic", "external_research"]},
    "summary": {"type": "string", "minLength": 1},
    "invalidated_assumptions": {"$ref": "#/$defs/strings"},
    "evidence": {"$ref": "#/$defs/strings"},
    "sources": {"$ref": "#/$defs/strings"},
    "candidate_discriminators": {"$ref": "#/$defs/strings"},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
