{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/deep-debugging/intake-output",
  "type": "object",
  "required": ["outcome", "symptom", "expected_behavior", "reproduction", "environment", "frequency", "affected_boundaries", "instrumentation_constraints", "cleanup_obligations", "fixed_evidence"],
  "properties": {
    "outcome": {"const": "ready"},
    "symptom": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "environment": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "frequency": {"type": "string", "minLength": 1},
    "change_window": {"type": ["string", "null"]},
    "affected_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "instrumentation_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "cleanup_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "fixed_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
