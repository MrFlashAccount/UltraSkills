{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/UltraSkills/schemas/workflow/deep-debugging/post-reset-judgment-output",
  "type": "object",
  "required": ["outcome", "next", "summary", "accepted_evidence", "information_gain", "post_reset_rounds", "remaining_distinct_experiments", "reason"],
  "properties": {
    "outcome": {"enum": ["confirmed", "continue", "unresolved_with_evidence"]},
    "next": {"enum": ["post_reset_experiment", "fix_and_verify", "cleanup"]},
    "summary": {"type": "string", "minLength": 1},
    "accepted_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "information_gain": {"type": "boolean"},
    "post_reset_rounds": {"type": "integer", "minimum": 1, "maximum": 2},
    "remaining_distinct_experiments": {"type": "integer", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "confirmed"}}, "required": ["outcome"]}, "then": {"properties": {"next": {"const": "fix_and_verify"}, "information_gain": {"const": true}}}},
    {"if": {"properties": {"outcome": {"const": "continue"}}, "required": ["outcome"]}, "then": {"properties": {"next": {"const": "post_reset_experiment"}, "remaining_distinct_experiments": {"const": 1}}}},
    {"if": {"properties": {"outcome": {"const": "unresolved_with_evidence"}}, "required": ["outcome"]}, "then": {"properties": {"next": {"const": "cleanup"}}}}
  ]
}
