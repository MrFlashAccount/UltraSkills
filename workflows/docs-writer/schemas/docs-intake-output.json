{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/docs-writer/docs-intake-output",
  "title": "Docs Writer Intake Output",
  "type": "object",
  "required": ["outcome", "task_class", "files_edited", "evidence_checked"],
  "properties": {
    "outcome": {"enum": ["tiny_ready", "full_cycle_ready", "devrel_writer"]},
    "task_class": {"enum": ["tiny", "full-cycle", "devrel-owned"]},
    "files_edited": {"const": false},
    "route_target": {"type": "string", "minLength": 1},
    "route_reason": {"type": "string", "minLength": 1},
    "contract": {
      "type": "object",
      "required": ["artifact_goal", "reader", "job_to_be_done", "first_win", "scope", "non_goals", "doc_mode", "prerequisites", "source_of_truth", "risks_unknowns"],
      "properties": {
        "artifact_goal": {"type": "string", "minLength": 1},
        "reader": {"type": "string", "minLength": 1},
        "job_to_be_done": {"type": "string", "minLength": 1},
        "first_win": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "doc_mode": {"enum": ["quick-start", "tutorial-getting-started", "how-to-guide", "reference", "explanation"]},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_of_truth": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "risks_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "evidence_checked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "results": {"type": "array", "items": {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/result"}}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "tiny_ready"}}, "required": ["outcome"]},
      "then": {
        "required": ["contract"],
        "properties": {"task_class": {"const": "tiny"}}
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "full_cycle_ready"}}, "required": ["outcome"]},
      "then": {
        "required": ["contract"],
        "properties": {"task_class": {"const": "full-cycle"}}
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "devrel_writer"}}, "required": ["outcome"]},
      "then": {
        "required": ["route_target", "route_reason"],
        "properties": {
          "task_class": {"const": "devrel-owned"},
          "route_target": {"const": "workflows/devrel-copywriter/workflow.toml"}
        }
      }
    }
  ]
}
