{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/hegel/dialectic-visionary-position-output",
  "type": "object",
  "required": ["outcome", "logical_position", "position_kind", "summary", "evidence_refs", "fingerprint", "artifacts"],
  "properties": {"outcome": {"const": "ready_for_freeze"}, "logical_position": {"const": "visionary"}, "position_kind": {"const": "thesis"}, "summary": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "fingerprint": {"$ref": "#/$defs/fingerprint"}, "artifacts": {"$ref": "#/$defs/artifacts"}},
  "additionalProperties": false,
  "$defs": {
    "fingerprint": {"type": "object", "required": ["causal_model", "recommendation", "assumptions", "evidence_interpretation", "baseline", "counterexamples"], "properties": {"causal_model": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}, "assumptions": {"type": "string", "minLength": 1}, "evidence_interpretation": {"type": "string", "minLength": 1}, "baseline": {"type": "string", "minLength": 1}, "counterexamples": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"}, {"type": "object", "required": ["id", "content_type"], "properties": {"id": {"const": "hegel-visionary-position"}, "content_type": {"const": "text/markdown"}}}]}], "items": false}
  }
}
