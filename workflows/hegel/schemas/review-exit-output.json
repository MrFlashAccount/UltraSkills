{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/hegel/review-exit-output",
  "type": "object",
  "required": ["outcome", "final_classification", "summary", "latest_diagnostic_report", "latest_hostile_findings", "review_iteration_count", "next_step"],
  "properties": {
    "outcome": {"const": "review_exhausted"},
    "final_classification": {"const": "unresolved_with_evidence"},
    "summary": {"type": "string", "minLength": 1},
    "latest_diagnostic_report": {"allOf": [{"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"}, {"type": "object", "required": ["id"], "properties": {"id": {"const": "diagnostic-report"}}}]},
    "latest_hostile_findings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["category", "severity", "evidence", "action"], "properties": {"category": {"enum": ["source_support", "shared_blind_spot", "unsupported_inference", "false_convergence", "counterexample", "baseline"]}, "severity": {"enum": ["must_fix", "should_fix", "note"]}, "evidence": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "review_iteration_count": {"const": 2},
    "next_step": {"const": "done"}
  },
  "additionalProperties": false
}
