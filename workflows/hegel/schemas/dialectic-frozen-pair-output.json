{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/hegel/dialectic-frozen-pair-output",
  "type": "object",
  "required": ["outcome", "shared_input_artifact", "positions"],
  "properties": {"outcome": {"const": "frozen"}, "shared_input_artifact": {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"}, "positions": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/visionary"}, {"$ref": "#/$defs/pragmatist"}], "items": false}},
  "additionalProperties": false,
  "$defs": {
    "fingerprint": {"type": "object", "required": ["causal_model", "recommendation", "assumptions", "evidence_interpretation", "baseline", "counterexamples"], "properties": {"causal_model": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}, "assumptions": {"type": "string", "minLength": 1}, "evidence_interpretation": {"type": "string", "minLength": 1}, "baseline": {"type": "string", "minLength": 1}, "counterexamples": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "position": {"type": "object", "required": ["logical_position", "artifact", "fingerprint", "accepted_output_step_id"], "properties": {"logical_position": {"enum": ["visionary", "pragmatist"]}, "artifact": {"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"}, "fingerprint": {"$ref": "#/$defs/fingerprint"}, "accepted_output_step_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "visionary": {"type": "object", "allOf": [{"$ref": "#/$defs/position"}, {"type": "object", "properties": {"logical_position": {"const": "visionary"}}}]},
    "pragmatist": {"type": "object", "allOf": [{"$ref": "#/$defs/position"}, {"type": "object", "properties": {"logical_position": {"const": "pragmatist"}}}]}
  }
}
