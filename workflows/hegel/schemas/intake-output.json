{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/hegel/intake-output",
  "type": "object",
  "required": ["outcome", "topic", "diagnostic_question", "known_constraints", "evidence_requirements", "source_requirements", "stopping_budget", "mutation_policy", "artifacts"],
  "properties": {
    "outcome": {"const": "ready_for_positions"},
    "topic": {"type": "string", "minLength": 1},
    "diagnostic_question": {"type": "string", "minLength": 1},
    "known_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stopping_budget": {"type": "object", "required": ["dialectic_cycles", "max_adjudications", "max_hostile_reviews"], "properties": {"dialectic_cycles": {"const": 1}, "max_adjudications": {"const": 1}, "max_hostile_reviews": {"const": 2}}, "additionalProperties": false},
    "mutation_policy": {"const": "read_only"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "https://github.com/MrFlashAccount/Skills/schemas/workflow/baton#/$defs/artifact"}, {"type": "object", "required": ["id", "content_type"], "properties": {"id": {"const": "hegel-diagnostic-brief"}, "content_type": {"const": "text/markdown"}}}]}], "items": false}
  },
  "additionalProperties": false
}
