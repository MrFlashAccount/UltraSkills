{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/devrel-copywriter/writing-output",
  "title": "DevRel Copywriter Writing Output",
  "type": "object",
  "required": ["outcome", "summary", "target_path", "changed_files", "evidence_checked", "decisions"],
  "properties": {
    "outcome": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "target_path": {"type": "string", "minLength": 1},
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_checked": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "decisions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "remaining_risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
