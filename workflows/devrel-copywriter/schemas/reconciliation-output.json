{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrFlashAccount/Skills/schemas/workflow/devrel-copywriter/reconciliation-output",
  "title": "DevRel Copywriter Reconciliation Output",
  "type": "object",
  "required": ["outcome", "summary", "chosen_direction", "tradeoffs", "evidence_checked", "decisions"],
  "properties": {
    "outcome": {"enum": ["ready_for_draft", "needs_approval"]},
    "summary": {"type": "string", "minLength": 1},
    "chosen_direction": {"type": "string", "minLength": 1},
    "tradeoffs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_checked": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
